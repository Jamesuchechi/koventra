# ── Database (Neon PostgreSQL) ──────────────────────────────────────────────
# Get this from your Neon dashboard → Project → Connection string
# Use the "pooled" connection string for production
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxxx.us-east-2.aws.neon.tech/neondb?sslmode=require"

# ── NextAuth ────────────────────────────────────────────────────────────────
# Must match your deployment URL exactly (no trailing slash)
NEXTAUTH_URL="http://localhost:3000"
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="your-secret-here"

# ── Image Storage ───────────────────────────────────────────────────────────
# Option A: Cloudinary (recommended)
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# Option B: Vercel Blob (alternative)
# BLOB_READ_WRITE_TOKEN=""

# ── Email / Resend ───────────────────────────────────────────────────────────
# Get from resend.com → API Keys
RESEND_API_KEY=""
RESEND_FROM_EMAIL="hello@koventrasystems.com"
RESEND_TO_EMAIL="hello@koventrasystems.com"

# ── Analytics ────────────────────────────────────────────────────────────────
NEXT_PUBLIC_PLAUSIBLE_DOMAIN="koventrasystems.com"

# ── Error Monitoring ─────────────────────────────────────────────────────────
SENTRY_DSN=""
NEXT_PUBLIC_SENTRY_DSN=""

# ── App ──────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
NODE_ENV="development"
